{
  "expo": {
    "name": "LiftBuddy",
    "slug": "liftbuddy",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "liftbuddy",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.liftbuddy.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A"
      },
      "package": "com.liftbuddy.app"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "LiftBuddy needs access to your photos for progress tracking and workout posts.",
          "cameraPermission": "LiftBuddy needs camera access to capture progress photos and workout selfies."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
